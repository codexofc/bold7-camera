<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/category_camera_settings">

        <ListPreference
            app:defaultValue="0"
            app:entries="@array/aspect_ratios"
            app:entryValues="@array/aspect_ratio_values"
            app:icon="@drawable/ic_camera_alt"
            app:key="aspect_ratio"
            app:title="@string/aspect_ratio_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:icon="@drawable/ic_camera"
            app:key="tap_to_take_photo"
            app:title="@string/tap_to_take_photo_title"
            app:summary="@string/tap_to_take_photo_summary" />

        <ListPreference
            app:defaultValue="internal"
            app:entries="@array/storage_locations"
            app:entryValues="@array/storage_location_values"
            app:icon="@drawable/ic_gallery"
            app:key="storage_location"
            app:title="@string/storage_location_title"
            app:summary="@string/storage_location_summary"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="system_default"
            app:icon="@drawable/ic_gallery"
            app:key="default_gallery_app"
            app:title="@string/default_gallery_app_title"
            app:summary="@string/default_gallery_app_summary"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="default"
            app:entries="@array/date_format_entries"
            app:entryValues="@array/date_format_values"
            app:icon="@drawable/ic_settings"
            app:key="filename_date_format"
            app:title="@string/filename_date_format_title"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/category_screen_recorder">

        <ListPreference
            app:defaultValue="native"
            app:entries="@array/screen_record_resolutions"
            app:entryValues="@array/screen_record_resolution_values"
            app:icon="@drawable/ic_videocam"
            app:key="screen_record_resolution"
            app:title="@string/screen_record_resolution_title"
            app:summary="@string/screen_record_resolution_summary"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="60"
            app:entries="@array/screen_record_fps_entries"
            app:entryValues="@array/screen_record_fps_values"
            app:icon="@drawable/ic_videocam"
            app:key="screen_record_fps"
            app:title="@string/screen_record_fps_title"
            app:summary="@string/screen_record_fps_summary"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="mic"
            app:entries="@array/screen_record_audio_entries"
            app:entryValues="@array/screen_record_audio_values"
            app:icon="@drawable/ic_info_outline"
            app:key="screen_record_audio"
            app:title="@string/screen_record_audio_title"
            app:summary="@string/screen_record_audio_summary"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="0"
            app:entries="@array/screen_record_countdown_entries"
            app:entryValues="@array/screen_record_countdown_values"
            app:icon="@drawable/ic_camera_alt"
            app:key="screen_record_countdown"
            app:title="@string/screen_record_countdown_title"
            app:summary="@string/screen_record_countdown_summary"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/category_appearance">

        <Preference
            app:icon="@drawable/ic_palette"
            app:key="button_color"
            app:summary="@string/button_color_summary"
            app:title="@string/button_color_title" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/category_info">
        <Preference
            app:icon="@drawable/ic_info_outline"
            app:key="about"
            app:summary="@string/about_summary"
            app:title="@string/about">
            <intent
                android:action="android.intent.action.VIEW"
                android:targetClass="com.light.lightcamera.AboutActivity"
                android:targetPackage="dev.bold7.camera.benos" />
        </Preference>
    </PreferenceCategory>

</PreferenceScreen>
